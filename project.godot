config_version=5

[application]
config/name="Timber Loot Tycoon"
config/version="0.28.12-alpha.1"
run/main_scene="res://Scenes/Boot.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://Assets/Brand/timber-icon.png"
boot_splash/bg_color=Color(0.063, 0.173, 0.161, 1)
boot_splash/show_image=true
boot_splash/image="res://Assets/Brand/timber-icon.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="TimberLootReborn"

[autoload]
Store="*res://SaveSystem/Store.gd"
RuntimeStats="*res://Managers/RuntimeStats.gd"
Game="*res://Managers/Game.gd"

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_width=360
window/size/min_height=640
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.35, 0.68, 0.75, 1)
textures/default_filters/use_nearest_mipmap_filter=false
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024

[audio]
driver/enable_input=false
